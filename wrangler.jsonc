{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nobre-creators",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ],
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "main": "src/worker.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "STATE",
        "class_name": "NobreState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "NobreState"
      ]
    }
  ]
}
